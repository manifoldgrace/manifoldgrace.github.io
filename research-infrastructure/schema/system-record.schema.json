{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparative Systems Research Record v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "domains",
    "components",
    "relationships",
    "claims",
    "review_status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SYS-[A-Za-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "research_date": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "kind"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "directed",
              "undirected"
            ]
          },
          "evidence_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "disputed",
              "unverified",
              "not_applicable"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "uri",
                "type",
                "accessed_at",
                "source_span"
              ],
              "properties": {
                "uri": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "official",
                    "peer_reviewed",
                    "benchmark",
                    "vendor",
                    "other"
                  ]
                },
                "accessed_at": {
                  "type": "string",
                  "format": "date"
                },
                "source_span": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "hash_sha256": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "status"
        ],
        "properties": {
          "control": {
            "type": "string"
          },
          "status": {
            "enum": [
              "tested",
              "documented",
              "unknown",
              "not_applicable"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "review_status": {
      "enum": [
        "intake",
        "extracted",
        "verified_with_qualifications",
        "human_approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
