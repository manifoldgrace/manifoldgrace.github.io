{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manifoldgrace.github.io/docs/evidence/master-index.schema.json",
  "title": "Manifold Grace Candidate Organisation Master Index Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "sectors",
    "entries"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "registry_version",
        "as_of_date",
        "status",
        "total_entry_slots",
        "sectors",
        "individually_completed_audits"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "registry_version": {
          "type": "string"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "const": "CANDIDATE_INDEX_NOT_AUDITED"
        },
        "proposed_standard": {
          "type": "string"
        },
        "total_entry_slots": {
          "const": 300
        },
        "sectors": {
          "const": 20
        },
        "individually_completed_audits": {
          "const": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sectors": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "sector_id",
          "name",
          "entry_count"
        ],
        "properties": {
          "sector_id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entry_count": {
            "const": 15
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit_id",
          "sector_id",
          "name",
          "audit_status",
          "claim_status",
          "retention_rule_status",
          "entity_classification",
          "canonical_audit_id",
          "source_evidence"
        ],
        "properties": {
          "audit_id": {
            "type": "string",
            "pattern": "^MG-AUD-[0-9]{3}$"
          },
          "sector_id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "audit_status": {
            "const": "NOT_AUDITED"
          },
          "claim_status": {
            "const": "UNVERIFIED_SOURCE_TEXT"
          },
          "retention_rule_status": {
            "const": "NOT_ASSESSED"
          },
          "entity_classification": {
            "const": "PENDING_REVIEW"
          },
          "canonical_audit_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^MG-AUD-[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_evidence": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  }
}
