# Optional standalone Cloudflare deployment; production is deployed with Sites.
name = "manifold-grace-media"
main = "worker.js"
compatibility_date = "2026-10-11"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "YOUR_PRIVATE_MEDIA_BUCKET"

# Configure UPLOAD_KEY and OWNER_EMAIL as secrets outside source control.
# The /owner route requires Sites authenticated identity headers.
